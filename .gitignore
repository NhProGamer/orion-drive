# Go
/orion-drive
/orion
*.exe
*.test
*.out

# Runtime data
/data/
conf.ini

# Frontend
/frontend/node_modules/
/frontend/dist/
*.local

# Built SPA assets (a fresh checkout embeds only .gitkeep; the backend then
# serves a placeholder page until `npm run build` fills this directory)
/application/statics/dist/*
!/application/statics/dist/.gitkeep

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# TS build info
/frontend/*.tsbuildinfo
/frontend/node_modules/.tmp/

# GoReleaser output
/dist/

# Tooling caches / stray lockfiles
.serena/
# pnpm is the package manager (see frontend/package.json "packageManager"), so
# its lockfile is committed and npm's is the stray one.
/frontend/package-lock.json

# Design assets staged here (branding); not part of the build
/tmp/

# Excalidraw runtime fonts, copied out of node_modules at build time
/frontend/public/excalidraw-assets/
