# Go
/orion-drive
/orion
*.exe
*.test
*.out

# Runtime data
/data/
conf.ini

# Frontend
/frontend/node_modules/
/frontend/dist/
*.local

# Built SPA assets (a fresh checkout embeds only .gitkeep; the backend then
# serves a placeholder page until `npm run build` fills this directory)
/application/statics/dist/*
!/application/statics/dist/.gitkeep

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# TS build info
/frontend/*.tsbuildinfo
/frontend/node_modules/.tmp/

# GoReleaser output
/dist/

# Tooling caches / stray lockfiles
.serena/
/frontend/pnpm-lock.yaml

# Design assets staged here (branding); not part of the build
/tmp/
