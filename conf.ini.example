; OrionDrive configuration.
; Every key can be overridden with an environment variable: OD_CONF_<Section>_<Key>
; e.g. OD_CONF_System_Listen=:8080  or  OD_CONF_OIDC_ClientSecret=xxx

[System]
; Listen address for the HTTP server.
Listen = :5212
; debug | release. Use release for any exposed instance. debug relaxes the
; session-secret check; the dev-login shortcut also needs a `-tags dev` build.
Mode = release
; Secret keying session and WOPI tokens. MUST be changed for release mode (the
; server refuses to start otherwise): use a long random value, e.g.
;   openssl rand -base64 48
SessionSecret = change-me-to-a-long-random-string
; Public base URL of this instance (used to build the OIDC redirect URI).
SiteURL = http://localhost:5212
; Comma-separated emails always granted admin access (bootstrap; independent of
; group permissions so you can't lock yourself out). e.g. admin@example.com,ops@example.com
AdminEmails =
; Comma-separated SSO groups/roles whose members get admin access, independent of
; their OrionDrive storage group. Requires [OIDC] GroupsClaim to be set. e.g. admins,sysops
AdminGroups =
; Days a file stays in the trash before the background job purges it permanently.
; 0 disables auto-purge. Default: 30.
TrashRetentionDays = 30
; Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted for
; client-IP resolution (per-IP rate limiting). Empty trusts none (client IP =
; direct peer). Set to your proxy, e.g. 127.0.0.1,::1 or 10.0.0.0/8
TrustedProxies =
; Content-Security-Policy header, sent on every response when non-empty (empty
; disables it) — defence-in-depth against XSS. The Office launcher sets its own
; CSP, so this can stay strict even with WOPI. Adapt to your deployment; a good
; starting point:
; CSP = default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
CSP =

[Database]
; sqlite | postgres | mysql
Type = sqlite
; For sqlite: path to the database file.
DBFile = data/orion.db
; For network databases (postgres/mysql). Port defaults to 5432 (postgres) or
; 3306 (mysql) when empty.
Host =
Port =
User =
Password =
Name = orion
; PostgreSQL sslmode (disable | require | verify-ca | verify-full). Ignored by
; sqlite/mysql. Default: disable.
SSLMode = disable

[OIDC]
; OpenID Connect provider (Google, Keycloak, Authentik, Azure AD, ...).
Issuer = https://accounts.google.com
ClientID =
ClientSecret =
; Must match SiteURL + /api/v1/auth/oidc/callback in the provider config.
RedirectURI = http://localhost:5212/api/v1/auth/oidc/callback
; Space-separated scopes. Include the scope that returns groups/roles if you use
; SSO group mapping (e.g. "groups" for Keycloak, "roles" for Authentik).
Scopes = openid profile email
; ID-token claim carrying the user's SSO groups/roles, mapped onto OrionDrive
; groups (configure the mapping per group in the admin panel). Default: groups.
GroupsClaim = groups

[Storage]
; Base directory for the default local storage policy.
LocalBasePath = data/storage
; 64-char hex (32-byte) AES-256 key enabling at-rest encryption for storage
; policies created with --encrypt. Generate with: openssl rand -hex 32
; Leave empty to disable encryption. Losing this key makes encrypted files unrecoverable.
EncryptionKey =
; Content-addressed deduplication of identical uploads:
;   off    (default) — never share stored blobs
;   user   — reuse a blob only among the SAME user's uploads (safe)
;   global — reuse a blob across ALL users (max disk savings). SECURITY NOTE: a
;            dedup hit can let one user infer that another already stored the
;            exact same content (an existence-leak side channel). Only enable if
;            that's acceptable for your threat model.
; Encrypted policies are never deduplicated (each object has a random IV).
Dedup = off
; Per-file version retention. Each save (edit, upload of the same name, Office
; autosave) keeps a new version; older ones beyond this cap are pruned and their
; storage freed on the next save. 0 = default (10); negative = unlimited history.
MaxVersions = 10

[Slave]
; Set Secret to turn this node into a storage slave: it then exposes the signed
; slave storage API and stores objects under StoragePath. The master must hold a
; matching "remote" storage policy (orion-drive policy add-remote) with the same
; secret. Leave Secret empty on a normal (master) node.
Secret =
StoragePath = data/slave-storage

[WOPI]
; Online Office editing via a WOPI client (OnlyOffice Docs, Collabora Online).
; Set ServerURL to the document server base — that alone enables Office editing.
; OrionDrive opens the editor via a WOPI form POST + iframe (a plain GET on the
; action URL returns 404 — this is expected). SiteURL must be reachable by the
; document server for its WOPI callbacks.
;
; Which formats can be edited/viewed, and each editor URL, are read from the
; server's WOPI discovery document (DiscoveryURL, default ServerURL +
; /hosting/discovery). This is the recommended, vendor-neutral setup.
;   ServerURL = https://office.example.com
;
; DiscoveryURL overrides the discovery location if it is not at the default path.
;   DiscoveryURL = https://office.example.com/hosting/discovery
;
; EditURLTemplate is an optional legacy fallback, used only when discovery is
; unavailable and has no entry for a file. {src} -> URL-encoded WOPISrc
; (required); {type} -> word|cell|slide per document (optional).
;   EditURLTemplate = https://office.example.com/hosting/wopi/{type}/edit?WOPISrc={src}
;
; VerifyProof enforces WOPI proof-key signature checks on editor callbacks. Off
; by default (OnlyOffice does not sign); enable with Collabora/Office Online.
; Secret signs WOPI access tokens. Empty falls back to System.SessionSecret; set
; a dedicated value to rotate the WOPI and session keys independently.
; ConvertSecret is ONLY for document thumbnails (see [Thumbnail]): leave empty
; for Collabora (its convert-to API needs no auth); set it to the OnlyOffice
; Document Server JWT secret to use OnlyOffice's conversion API instead. With
; OnlyOffice, System.SiteURL must be reachable from the document server (it
; fetches the file itself). No local LibreOffice is required either way.
ServerURL =
DiscoveryURL =
EditURLTemplate =
Secret =
VerifyProof = false
ConvertSecret =

[SFTP]
; Expose the drive over SFTP, authenticated with the SAME dedicated credentials
; as WebDAV (create them in the app → "WebDAV / SFTP access"). Disabled by
; default; it opens a separate SSH port.
Enable = false
; Address the SFTP (SSH) server listens on.
Listen = :2222
; Where the SSH host key is stored (generated on first run if missing). Keep it
; stable so clients don't warn about a changed host key.
HostKeyPath = data/ssh_host_ed25519_key

[Archive]
; Safety limits when extracting archives, guarding against decompression bombs
; and quota abuse. Any value left at 0 uses the built-in default.
; MaxEntries     : max members an archive may unpack to (default 100000).
; MaxSizeMB      : ceiling on total uncompressed output when the user's quota is
;                  unlimited (default 51200 = 50 GiB).
; MaxRatio       : max uncompressed:compressed ratio; above it the archive is a
;                  decompression bomb (default 1000). Only enforced above
;                  RatioFloorMB, so small highly-compressible files still extract.
; RatioFloorMB   : size below which the ratio is not enforced (default 1024 = 1 GiB).
; TimeoutSeconds : per-extraction wall-clock cap (default 300).
MaxEntries = 0
MaxSizeMB = 0
MaxRatio = 0
RatioFloorMB = 0
TimeoutSeconds = 0

[Security]
; SharePublicRatePerMin caps requests per client IP per minute on the public
; share endpoints (password guessing, anonymous uploads/edits). Default 120.
; Set to a negative value to disable. The resumable-upload chunk PUT is exempt.
SharePublicRatePerMin = 120

[Thumbnail]
; Preview-thumbnail generation. Handled in pure Go: JPG/PNG/GIF/WebP/BMP/TIFF,
; e-book & comic covers (EPUB/CBZ/CBT/FB2/MOBI/AZW3), Photoshop previews
; (PSD/PSB) and font specimens (TTF/OTF/TTC). Richer formats use external tools
; when present: ffmpeg (video frames, audio cover art), libvips
; (HEIC/AVIF/TGA/...), librsvg (SVG), LibRaw (camera RAW), LibreOffice + poppler
; (Office/ODF, EPS/AI and PDF). Each external tool is skipped when its binary is
; missing. When LibreOffice is absent but a WOPI document server is configured
; ([WOPI] ServerURL), Office/ODF thumbnails are rendered through it instead — no
; local LibreOffice needed. Collabora is used directly; for OnlyOffice, also set
; [WOPI] ConvertSecret (its JWT secret).
; Disable          : master off-switch for all thumbnails.
; MaxDim / Quality : longest edge in px (default 400) and JPEG quality (default 82).
; DisableVideo/Audio/Vips/Raw/PDF/Document/Ebook : force a generator off even if present.
; *Path            : override a binary location (default: found on PATH).
Disable = false
MaxDim = 0
Quality = 0
DisableVideo = false
DisableAudio = false
DisableVips = false
DisableRaw = false
DisablePDF = false
DisableDocument = false
DisableEbook = false
FFmpegPath =
VipsPath =
PopplerPath =
LibreOfficePath =
LibRawPath =

[Redis]
; Set Server (host:port) to back the cache (upload sessions, OIDC states, ...)
; with Redis instead of in-process memory — required when running several
; OrionDrive nodes so they share ephemeral state. Leave empty for in-memory.
Server =
Password =
DB = 0

[Board]
; Collaborative whiteboards (.excalidraw). Several people open the same board —
; signed-in users and share-link visitors alike — and draw together in real
; time over a WebSocket; the server merges their edits and snapshots the scene
; back into the file. One drawing session leaves one entry in the file's version
; history, not one per autosave. Any value left at 0 uses the built-in default.
; Disable             : turn collaboration off; boards then open read-only.
; MaxSceneMB          : ceiling on a board's document, and on a single inbound
;                       frame. Pasted images are embedded in the document, so
;                       this bounds how much one editor can push (default 32).
; MaxElements         : max shapes per board (default 20000).
; MaxPeers            : max concurrent editors per board (default 30).
; SaveIntervalSeconds : shortest delay between two snapshots of a board being
;                       actively drawn on (default 5).
Disable = false
MaxSceneMB = 0
MaxElements = 0
MaxPeers = 0
SaveIntervalSeconds = 0
