; OrionDrive configuration.
; Every key can be overridden with an environment variable: OD_CONF_<Section>_<Key>
; e.g. OD_CONF_System_Listen=:8080  or  OD_CONF_OIDC_ClientSecret=xxx

[System]
; Listen address for the HTTP server.
Listen = :5212
; debug | release
Mode = debug
; Random secret used to sign sessions and JWTs. CHANGE THIS.
SessionSecret = change-me-to-a-long-random-string
; Public base URL of this instance (used to build the OIDC redirect URI).
SiteURL = http://localhost:5212
; Comma-separated emails always granted admin access (bootstrap; independent of
; group permissions so you can't lock yourself out). e.g. admin@example.com,ops@example.com
AdminEmails =
; Comma-separated SSO groups/roles whose members get admin access, independent of
; their OrionDrive storage group. Requires [OIDC] GroupsClaim to be set. e.g. admins,sysops
AdminGroups =
; Days a file stays in the trash before the background job purges it permanently.
; 0 disables auto-purge. Default: 30.
TrashRetentionDays = 30

[Database]
; sqlite | postgres | mysql
Type = sqlite
; For sqlite: path to the database file.
DBFile = data/orion.db
; For network databases (postgres/mysql). Port defaults to 5432 (postgres) or
; 3306 (mysql) when empty.
Host =
Port =
User =
Password =
Name = orion
; PostgreSQL sslmode (disable | require | verify-ca | verify-full). Ignored by
; sqlite/mysql. Default: disable.
SSLMode = disable

[OIDC]
; OpenID Connect provider (Google, Keycloak, Authentik, Azure AD, ...).
Issuer = https://accounts.google.com
ClientID =
ClientSecret =
; Must match SiteURL + /api/v1/auth/oidc/callback in the provider config.
RedirectURI = http://localhost:5212/api/v1/auth/oidc/callback
; Space-separated scopes. Include the scope that returns groups/roles if you use
; SSO group mapping (e.g. "groups" for Keycloak, "roles" for Authentik).
Scopes = openid profile email
; ID-token claim carrying the user's SSO groups/roles, mapped onto OrionDrive
; groups (configure the mapping per group in the admin panel). Default: groups.
GroupsClaim = groups

[Storage]
; Base directory for the default local storage policy.
LocalBasePath = data/storage
; 64-char hex (32-byte) AES-256 key enabling at-rest encryption for storage
; policies created with --encrypt. Generate with: openssl rand -hex 32
; Leave empty to disable encryption. Losing this key makes encrypted files unrecoverable.
EncryptionKey =

[Slave]
; Set Secret to turn this node into a storage slave: it then exposes the signed
; slave storage API and stores objects under StoragePath. The master must hold a
; matching "remote" storage policy (orion-drive policy add-remote) with the same
; secret. Leave Secret empty on a normal (master) node.
Secret =
StoragePath = data/slave-storage

[WOPI]
; Online Office editing via a WOPI client (OnlyOffice Docs, Collabora Online).
; ServerURL is the Office server base. EditURLTemplate builds the editor action URL:
;   {src}  -> the URL-encoded WOPISrc (required)
;   {type} -> word|cell|slide per document (optional; lets .docx/.xlsx/.pptx all work)
; OrionDrive opens the editor via a WOPI form POST + iframe (a plain GET on the
; action URL returns 404 — this is expected). SiteURL must be reachable by the
; Office server (for its WOPI callbacks). Both empty disables Office editing.
; OnlyOffice example:
;   ServerURL = https://office.example.com
;   EditURLTemplate = https://office.example.com/hosting/wopi/{type}/edit?WOPISrc={src}
; Collabora example:
;   ServerURL = https://collabora.example.com
;   EditURLTemplate = https://collabora.example.com/browser/dist/cool.html?WOPISrc={src}
ServerURL =
EditURLTemplate =

[Redis]
; Set Server (host:port) to back the cache (upload sessions, OIDC states, ...)
; with Redis instead of in-process memory — required when running several
; OrionDrive nodes so they share ephemeral state. Leave empty for in-memory.
Server =
Password =
DB = 0
